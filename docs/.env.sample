# ==============================================================================
# PORTAL IRIBEIRO - EXEMPLO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.sample)
# ==============================================================================
# Instruções: 
# 1. Copie este arquivo e renomeie-o para '.env' na raiz do seu projeto da API.
# 2. Substitua os placeholders abaixo pelos seus valores reais de desenvolvimento.
# 3. Este arquivo (.env.sample) DEVE ser commitado no Git. O '.env' NÃO DEVE.
# ==============================================================================

# ------------------------------------------------------------------------------
# CONEXÕES DE BANCO DE DADOS & CACHE (Mapeia para ConnectionStrings)
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection="Host=localhost;Database=postgres;Username=admin;Password=SUA_SENHA_AQUI;SearchPath=portal;SSL Mode=Disable;Trust Server Certificate=true;"
ConnectionStrings__Redis="ENDERECO_DO_REDIS_OU_UPSTASH"

# ------------------------------------------------------------------------------
# INTEGRAÇÃO COM IA (Mapeia para Gemini)
# ------------------------------------------------------------------------------
Gemini__ApiKey="SUA_CHAVE_API_DO_GEMINI_AQUI"

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO ASP.NET CORE
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT="Development"

# ------------------------------------------------------------------------------
# GEOLOCALIZAÇÃO DE IP
# ------------------------------------------------------------------------------

GeoIp__BaseUrl="http://ip-api.com"
GeoIp__FallbackIp="8.8.8.8"

# ==============================================================================
# KOYEB (PRODUÇÃO) - VARIÁVEIS DE AMBIENTE DO SERVIÇO
# ==============================================================================
# Em produção o '.env' NÃO é usado (nem é copiado para a imagem/artefatos).
# Defina as MESMAS chaves abaixo como Environment Variables / Secrets do
# serviço na Koyeb. A aplicação lê somente as variáveis de ambiente.
#
#   ConnectionStrings__DefaultConnection="Host=SEU_POSTGRES_REACHABLE;Database=postgres;Username=admin;Password=SUA_SENHA_AQUI;SearchPath=portal;SSL Mode=Disable;Trust Server Certificate=true;"
#   ConnectionStrings__Redis="ENDERECO_DO_REDIS_OU_UPSTASH"
#   Gemini__ApiKey="SUA_CHAVE_API_DO_GEMINI_AQUI"
#   ASPNETCORE_ENVIRONMENT="Production"
#   GeoIp__BaseUrl="http://ip-api.com"
#   GeoIp__FallbackIp="8.8.8.8"
#
# OBS: o Host do PostgreSQL deve ser alcançável a partir da Koyeb (ex.:
# Postgres gerenciado com TLS). Valores locais (localhost) NÃO funcionam.
# ==============================================================================
