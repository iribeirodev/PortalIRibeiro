# ==============================================================================
# PORTAL IRIBEIRO - EXEMPLO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.sample)
# ==============================================================================
# Instruções: 
# 1. Copie este arquivo e renomeie-o para '.env' na raiz do seu projeto da API.
# 2. Substitua os placeholders abaixo pelos seus valores reais de desenvolvimento.
# 3. Este arquivo (.env.sample) DEVE ser commitado no Git. O '.env' NÃO DEVE.
# ==============================================================================

# ------------------------------------------------------------------------------
# CONEXÕES DE BANCO DE DADOS & CACHE (Mapeia para ConnectionStrings)
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection="Host=localhost;Database=postgres;Username=admin;Password=SUA_SENHA_AQUI;SearchPath=portal;SSL Mode=Disable;Trust Server Certificate=true;"
# Formato do Upstash: host:porta,password=...,user=default,ssl=true
# ATENÇÃO: o StackExchange.Redis NÃO aceita os schemes redis:// ou rediss://.
# O Redis é usado hoje no RATE LIMITING (fail-closed) do chat da Íris (10/dia por IP).
# A deduplicação de telemetria/visitas ficou no PostgreSQL (tabela portal.visit_cache).
ConnectionStrings__Redis="cunning-lamb-127245.upstash.io:6379,password=SUA_SENHA_AQUI,user=default,ssl=true,abortConnect=false,connectTimeout=5000"

# ------------------------------------------------------------------------------
# INTEGRAÇÃO COM IA (Mapeia para Gemini)
# ------------------------------------------------------------------------------
Gemini__ApiKey="SUA_CHAVE_API_DO_GEMINI_AQUI"

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO ASP.NET CORE
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT="Development"

# ------------------------------------------------------------------------------
# GEOLOCALIZAÇÃO DE IP
# ------------------------------------------------------------------------------

GeoIp__BaseUrl="http://ip-api.com"
GeoIp__FallbackIp="8.8.8.8"

# ==============================================================================
# KOYEB (PRODUÇÃO) - VARIÁVEIS DE AMBIENTE DO SERVIÇO
# ==============================================================================
# Em produção o '.env' NÃO é usado (nem é copiado para a imagem/artefatos).
# Defina as MESMAS chaves abaixo como Environment Variables / Secrets do
# serviço na Koyeb. A aplicação lê somente as variáveis de ambiente.
#
#   ConnectionStrings__DefaultConnection="Host=SEU_POSTGRES_REACHABLE;Database=postgres;Username=admin;Password=SUA_SENHA_AQUI;SearchPath=portal;SSL Mode=Disable;Trust Server Certificate=true;"
#   ConnectionStrings__Redis="cunning-lamb-127245.upstash.io:6379,password=SUA_SENHA_AQUI,user=default,ssl=true,abortConnect=false,connectTimeout=5000"
#   Gemini__ApiKey="SUA_CHAVE_API_DO_GEMINI_AQUI"
#   ASPNETCORE_ENVIRONMENT="Production"
#   GeoIp__BaseUrl="http://ip-api.com"
#   GeoIp__FallbackIp="8.8.8.8"
#   RateLimit__Iris__PermitLimit=10        # máx. de perguntas por IP por dia
#   RateLimit__Iris__WindowMinutes=1440    # janela do limite (24h)
#
# OBS: o Host do PostgreSQL deve ser alcançável a partir da Koyeb (ex.:
# Postgres gerenciado com TLS, como a Neon). Valores locais (localhost) NÃO funcionam.
#
# Deploy por Git: conecte o repositório (branch main) no serviço Koyeb, use o
# Dockerfile da raiz (Native AOT), porta 8080 e health check em /health.
# ==============================================================================

# ==============================================================================
# VERCEL (PRODUÇÃO) - FRONTEND ANGULAR
# ==============================================================================
# O frontend (pasta frontend/) usa 'environment.prod.ts' com apiUrl relativo
# '/api'. O arquivo 'frontend/vercel.json' reescreve '/api/:path*' para a Koyeb:
#
#   {
#     "buildCommand": "npm run build",
#     "outputDirectory": "dist/frontend-angular/browser",
#     "rewrites": [
#       { "source": "/api/:path*", "destination": "https://portaliribeiro-api.koyeb.app/api/:path*" }
#     ]
#   }
#
# Projeto no Vercel: Root Directory = 'frontend', framework Angular (auto).
# NÃO é mais necessário definir NEXT_PUBLIC_API_BASE_URL (versão Next.js antiga).
# ==============================================================================
