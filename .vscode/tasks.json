{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PortalIRibeiro.API/PortalIRibeiro.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-frontend",
            "type": "npm",
            "script": "build",
            "path": "${workspaceFolder}/frontend",
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "serve-frontend",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "start",
                "--",
                "--open"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "npm",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Application bundle generation complete.*|Watch mode enabled.*"
                },
                "pattern": {
                    "regexp": "(error|warn)\\s+(.+)",
                    "file": 2,
                    "line": 3
                }
            }
        },
        {
            "label": "run-ecosystem",
            "dependsOn": [
                "build-api",
                "serve-frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}