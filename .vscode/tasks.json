{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-api",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/PortalIRibeiro.API/PortalIRibeiro.API.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-frontend",
            "type": "npm",
            "script": "build",
            "path": "frontend",
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "serve-frontend",
            "type": "npm",
            "script": "start",
            "path": "frontend",
            "isBackground": false,
            "problemMatcher": []
        },
        {
            "label": "run-ecosystem",
            "dependsOn": [
                "run-api",
                "serve-frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}