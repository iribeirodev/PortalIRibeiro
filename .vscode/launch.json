{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (API)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "run-ecosystem",
            "program": "${workspaceFolder}/PortalIRibeiro.API/bin/Debug/net10.0/PortalIRibeiro.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PortalIRibeiro.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Frontend (Angular)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Rodar Ecossistema Completo (API + Angular)",
            "configurations": [
                ".NET Core Launch (API)",
                "Frontend (Angular)"
            ]
        }
    ]
}